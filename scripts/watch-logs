#!/usr/bin/env python3
"""Watch new sandbox pods in openshift-lightspeed and save their logs."""

import argparse
import sys
from pathlib import Path

from sandbox_logs import watch_logs


def main():
    parser = argparse.ArgumentParser(
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""Only pods created after startup are captured. Existing pods are skipped.
Logs from the agent container are saved in the output directory as
AGENTICRUN-PHASE.log (analysis, execution, or verification). If the run or
phase is unknown, the filename is POD.log. Existing files are kept;
new files get a number, such as AGENTICRUN-analysis-1.log.
The output directory is created if needed.

Press Ctrl+C to stop the watch and all active log streams.

Example:
  ./watch-logs --output-dir ./logs""",
    )
    parser.add_argument(
        "-o", "--output-dir", type=Path, default=Path.cwd(), metavar="DIRECTORY",
        help="directory for log files (default: current directory)",
    )
    args = parser.parse_args()
    return watch_logs(args.output_dir)


if __name__ == "__main__":
    sys.exit(main())
